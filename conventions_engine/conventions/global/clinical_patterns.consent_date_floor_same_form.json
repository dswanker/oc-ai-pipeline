{
  "id": "clinical_patterns.consent_date_floor_same_form",
  "title": "Event dates on the consent form's own form cannot precede the consent date",
  "kind": "hybrid",
  "scope": "global",
  "status": "active",
  "natural_key": "consent_date_floor_same_form",
  "description": "When the informed consent date is on the same form as an on-study event date (e.g. a demographics/visit form), the event date gets `. >= ${<consent field>}` directly.",
  "rationale": "Regulatory requirement — any study activity performed before informed consent is a serious protocol deviation. Catching pre-consent dates at entry rather than in monitoring saves the deviation report and the corrective-action cycle. The floor is universal across all event dates; the exception for ICF-form dates is structural (the form that captures consent can't be gated on consent already being captured).",
  "target": "field",
  "created_at": "2026-10-08T00:00:00Z",
  "created_by": "system:cdisc_core_checks",
  "source": "consolidation:prompts.py:RULE_OC-7L",
  "tags": [
    "consent",
    "edit_check",
    "cross_field"
  ],
  "applies_when": {
    "all_of": [
      {
        "all_of": [
          {
            "field.type": {
              "in": [
                "date",
                "datetime"
              ]
            }
          },
          {
            "any_of": [
              {
                "field.concept": {
                  "matches": "^(AE(ST|EN)DAT|VISDAT|EX(ST|EN)DAT|EC(ST|EN)DAT|(LB|VS|EG|PE|QS|MB|PC|BE|BS)DAT|DSSTDAT|DV(ST|EN)?DAT)$"
                }
              },
              {
                "field.name": {
                  "matches": "^(AE(ST|EN)DAT|VISDAT|EX(ST|EN)DAT|EC(ST|EN)DAT|(LB|VS|EG|PE|QS|MB|PC|BE|BS)DAT|DSSTDAT|DV(ST|EN)?DAT)$"
                }
              }
            ]
          }
        ]
      },
      {
        "field.has_sibling": {
          "where": {
            "all_of": [
              {
                "any_of": [
                  {
                    "field.concept": "RFICDAT"
                  },
                  {
                    "field.name": {
                      "in": [
                        "ICFDAT",
                        "RFICDAT",
                        "CONSDAT",
                        "ICDAT"
                      ]
                    }
                  }
                ]
              },
              {
                "field.type": {
                  "in": [
                    "date",
                    "datetime"
                  ]
                }
              }
            ]
          },
          "scope": "same_form",
          "as": "icf"
        }
      }
    ]
  },
  "effect": {
    "add_constraint": {
      "expr": ". = '' or ${${icf.name}} = '' or . >= ${${icf.name}}",
      "message": "Date cannot be before the informed consent date.",
      "check_id": "CONSENT_FLOOR",
      "skip_if_references": "${${icf.name}}"
    }
  }
}
