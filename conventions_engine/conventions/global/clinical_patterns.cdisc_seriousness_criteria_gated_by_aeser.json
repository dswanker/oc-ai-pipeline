{
  "id": "clinical_patterns.cdisc_seriousness_criteria_gated_by_aeser",
  "title": "Seriousness criteria are asked only when the AE is serious (CDASHIG AE)",
  "kind": "hybrid",
  "scope": "global",
  "status": "active",
  "natural_key": "cdisc_seriousness_criteria_gated_by_aeser",
  "description": "Each seriousness-criterion field gets relevant = Serious is Yes (using the Serious field's own Yes code), unless it already has a relevant.",
  "rationale": "CDASHIG collects the seriousness criteria for serious AEs. Asking them for non-serious AEs invites the Serious = No / criterion = Yes contradiction that CORE-000022 flags at submission.",
  "target": "field",
  "created_at": "2026-10-08T00:00:00Z",
  "created_by": "system:cdisc_core_checks",
  "source": "cdisc:cdashig:2.3:AE",
  "tags": [
    "cdisc",
    "cdashig",
    "ae",
    "edit_check"
  ],
  "applies_when": {
    "all_of": [
      {
        "any_of": [
          {
            "field.concept": {
              "in": [
                "AESDTH",
                "AESLIFE",
                "AESHOSP",
                "AESDISAB",
                "AESCONG",
                "AESMIE"
              ]
            }
          },
          {
            "field.name": {
              "in": [
                "AESDTH",
                "AESLIFE",
                "AESHOSP",
                "AESDISAB",
                "AESCONG",
                "AESMIE"
              ]
            }
          }
        ]
      },
      {
        "field.type": {
          "matches": "^select_one "
        }
      },
      {
        "field.has_sibling": {
          "where": {
            "all_of": [
              {
                "any_of": [
                  {
                    "field.concept": "AESER"
                  },
                  {
                    "field.name": "AESER"
                  }
                ]
              },
              {
                "field.type": {
                  "matches": "^select_one "
                }
              }
            ]
          },
          "scope": "same_form",
          "as": "serious"
        }
      }
    ]
  },
  "effect": {
    "ensure": {
      "field.relevant": "${${serious.name}} = '${serious._yes_code}'"
    }
  }
}
