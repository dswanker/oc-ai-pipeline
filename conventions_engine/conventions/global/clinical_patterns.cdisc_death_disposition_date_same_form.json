{
  "id": "clinical_patterns.cdisc_death_disposition_date_same_form",
  "title": "Disposition Death date equals the date of death on the same form (CORE-000034)",
  "kind": "hybrid",
  "scope": "global",
  "status": "active",
  "natural_key": "cdisc_death_disposition_date_same_form",
  "description": "As above when the date of death is on the disposition form itself: compared directly.",
  "rationale": "CDISC CORE-000034: the DS date for a DEATH disposition must equal the date of death (DM.DTHDTC). Conflicting death dates across forms are a safety-reporting defect and a submission finding.",
  "target": "field",
  "created_at": "2026-10-08T00:00:00Z",
  "created_by": "system:cdisc_core_checks",
  "source": "cdisc:core:CORE-000034",
  "tags": [
    "cdisc",
    "core",
    "ds",
    "death",
    "edit_check",
    "cross_form"
  ],
  "applies_when": {
    "all_of": [
      {
        "all_of": [
          {
            "field.type": {
              "in": [
                "date",
                "datetime"
              ]
            }
          },
          {
            "any_of": [
              {
                "field.concept": "DSSTDAT"
              },
              {
                "field.name": "DSSTDAT"
              }
            ]
          }
        ]
      },
      {
        "field.has_sibling": {
          "where": {
            "all_of": [
              {
                "field.type": {
                  "matches": "^select_one "
                }
              },
              {
                "any_of": [
                  {
                    "field.concept": "DSDECOD"
                  },
                  {
                    "field.name": "DSDECOD"
                  }
                ]
              }
            ]
          },
          "scope": "same_form",
          "as": "decod"
        }
      },
      {
        "field.has_sibling": {
          "where": {
            "all_of": [
              {
                "field.type": {
                  "in": [
                    "date",
                    "datetime"
                  ]
                }
              },
              {
                "any_of": [
                  {
                    "field.concept": "DTHDAT"
                  },
                  {
                    "field.name": {
                      "in": [
                        "DTHDAT",
                        "DEATHDAT",
                        "DTHDT"
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "scope": "same_form",
          "as": "dth"
        }
      }
    ]
  },
  "effect": {
    "add_constraint": {
      "expr": "${${decod.name}} != '${decod._code.DEATH}' or ${${dth.name}} = '' or . = ${${dth.name}}",
      "message": "Disposition is Death: the disposition date must equal the date of death.",
      "check_id": "CORE-000034"
    }
  }
}
