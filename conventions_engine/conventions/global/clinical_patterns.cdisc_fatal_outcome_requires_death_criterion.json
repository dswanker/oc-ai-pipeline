{
  "id": "clinical_patterns.cdisc_fatal_outcome_requires_death_criterion",
  "title": "AE outcome Fatal requires 'Results in death' = Yes (SDTM AE consistency)",
  "kind": "hybrid",
  "scope": "global",
  "status": "active",
  "natural_key": "cdisc_fatal_outcome_requires_death_criterion",
  "description": "On AE outcome, when the form has the 'Results in death' criterion, add a check that outcome Fatal has death = Yes. Fatal and Yes are read from each field's own list.",
  "rationale": "SDTMIG AE consistency (FDA/CDISC rule pair AEOUT=FATAL <-> AESDTH=Y). Inconsistent death reporting is a safety-reporting defect caught late if not checked at entry.",
  "target": "field",
  "created_at": "2026-10-08T00:00:00Z",
  "created_by": "system:cdisc_core_checks",
  "source": "cdisc:core:deprecated:AEOUT_FATAL_AESDTH",
  "tags": [
    "cdisc",
    "sdtm",
    "ae",
    "edit_check"
  ],
  "applies_when": {
    "all_of": [
      {
        "any_of": [
          {
            "field.concept": "AEOUT"
          },
          {
            "field.name": "AEOUT"
          }
        ]
      },
      {
        "field.type": {
          "matches": "^select_one "
        }
      },
      {
        "field.has_sibling": {
          "where": {
            "all_of": [
              {
                "any_of": [
                  {
                    "field.concept": "AESDTH"
                  },
                  {
                    "field.name": "AESDTH"
                  }
                ]
              },
              {
                "field.type": {
                  "matches": "^select_one "
                }
              }
            ]
          },
          "scope": "same_form",
          "as": "death"
        }
      }
    ]
  },
  "effect": {
    "add_constraint": {
      "expr": ". != '${field._code.FATAL}' or ${${death.name}} = '${death._yes_code}'",
      "message": "Outcome is Fatal: 'Results in death' must be Yes.",
      "check_id": "SDTM.AEOUT_FATAL_AESDTH"
    }
  }
}
