{
  "id": "clinical_patterns.cdisc_death_disposition_date_cross_form",
  "title": "Disposition Death date equals the date of death recorded on another form (CORE-000034)",
  "kind": "hybrid",
  "scope": "global",
  "status": "active",
  "natural_key": "cdisc_death_disposition_date_cross_form",
  "description": "On the disposition date (DSSTDAT) of a form with the disposition decode, when the date of death (DTHDAT) is recorded on a different form: fetch it (DTHDAT_CF, by item/item-group name) and check that a DEATH disposition's date equals it. DEATH is read from the disposition list's own codes.",
  "rationale": "CDISC CORE-000034: the DS date for a DEATH disposition must equal the date of death (DM.DTHDTC). Conflicting death dates across forms are a safety-reporting defect and a submission finding.",
  "target": "field",
  "created_at": "2026-10-08T00:00:00Z",
  "created_by": "system:cdisc_core_checks",
  "source": "cdisc:core:CORE-000034",
  "tags": [
    "cdisc",
    "core",
    "ds",
    "death",
    "edit_check",
    "cross_form"
  ],
  "applies_when": {
    "all_of": [
      {
        "all_of": [
          {
            "field.type": {
              "in": [
                "date",
                "datetime"
              ]
            }
          },
          {
            "any_of": [
              {
                "field.concept": "DSSTDAT"
              },
              {
                "field.name": "DSSTDAT"
              }
            ]
          }
        ]
      },
      {
        "field.has_sibling": {
          "where": {
            "all_of": [
              {
                "field.type": {
                  "matches": "^select_one "
                }
              },
              {
                "any_of": [
                  {
                    "field.concept": "DSDECOD"
                  },
                  {
                    "field.name": "DSDECOD"
                  }
                ]
              }
            ]
          },
          "scope": "same_form",
          "as": "decod"
        }
      },
      {
        "none_of": [
          {
            "field.has_sibling": {
              "where": {
                "all_of": [
                  {
                    "field.type": {
                      "in": [
                        "date",
                        "datetime"
                      ]
                    }
                  },
                  {
                    "any_of": [
                      {
                        "field.concept": "DTHDAT"
                      },
                      {
                        "field.name": {
                          "in": [
                            "DTHDAT",
                            "DEATHDAT",
                            "DTHDT"
                          ]
                        }
                      }
                    ]
                  }
                ]
              },
              "scope": "same_form"
            }
          }
        ]
      },
      {
        "study.has_field": {
          "where": {
            "all_of": [
              {
                "field.type": {
                  "in": [
                    "date",
                    "datetime"
                  ]
                }
              },
              {
                "any_of": [
                  {
                    "field.concept": "DTHDAT"
                  },
                  {
                    "field.name": {
                      "in": [
                        "DTHDAT",
                        "DEATHDAT",
                        "DTHDT"
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "as": "dth"
        }
      }
    ]
  },
  "effect": {
    "lookup_from": {
      "from": "${dth._form_id}.${dth.name}",
      "name": "DTHDAT_CF",
      "purpose": "Date of death, for the CORE-000034 disposition check",
      "only_if_resolves": "${decod._code.DEATH}"
    },
    "add_constraint": {
      "expr": "${${decod.name}} != '${decod._code.DEATH}' or ${DTHDAT_CF} = '' or . = ${DTHDAT_CF}",
      "message": "Disposition is Death: the disposition date must equal the date of death.",
      "check_id": "CORE-000034",
      "requires_field": "DTHDAT_CF",
      "skip_if_references": "DTHDAT_CF"
    }
  }
}
