{
  "id": "customer.bioivt.lab_unit_rows",
  "title": "BioIVT: a unit lookup beside lab values that had no unit question",
  "kind": "structured",
  "scope": "customer",
  "scope_id": "bioIVT",
  "status": "active",
  "natural_key": "bioivt_lab_unit_rows",
  "description": "Adds a type-ahead unit question (UCUM) directly after six lab result values that had no unit question (ESR, CRP and four Lupus values), shown only when the value is.",
  "rationale": "Option C: a value is only analysable with its unit.",
  "target": "field",
  "applies_when": {
    "any_of": [
      {
        "form.form_id": "RA",
        "field.name": "ESR_RES"
      },
      {
        "form.form_id": "RA",
        "field.name": "CRP_RES"
      },
      {
        "form.form_id": "LUPUS",
        "field.name": "RESRD1B"
      },
      {
        "form.form_id": "LUPUS",
        "field.name": "RESHD2"
      },
      {
        "form.form_id": "LUPUS",
        "field.name": "RESHD3"
      },
      {
        "form.form_id": "LUPUS",
        "field.name": "RESHD4"
      }
    ]
  },
  "effect": {
    "insert_after": {
      "name": "{self}_U",
      "type": "select_one_from_file ucum_units_demo.csv",
      "label": "Unit",
      "appearance": "minimal autocomplete",
      "inherit_relevant": true,
      "register_vocab": "ucum_units_demo.csv"
    }
  },
