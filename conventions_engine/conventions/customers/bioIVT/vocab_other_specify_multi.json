  "natural_key": "bioivt_vocab_other_specify_multi",
  "description": "Adds an 'Other (not in list), specify' free-text question after each multi-select agent lookup on Outcome, shown only when Other is among the choices.",
  "rationale": "Approved choice-list rules 1 and 2.",
  "target": "field",
  "applies_when": {
    "any_of": [
      {
        "form.form_id": "OUTCOME",
        "field.name": "CHEMO_AGENTS"
      },
      {
        "form.form_id": "OUTCOME",
        "field.name": "MTT_AGENTS"
      },
      {
        "form.form_id": "OUTCOME",
        "field.name": "IMMUNO_AGENTS"
      },
      {
        "form.form_id": "OUTCOME",
        "field.name": "HORMONE_AGENTS"
      }
    ]
  },
  "effect": {
    "insert_after": {
      "name": "{self}_OTH",
      "type": "text",
      "label": "Other agents (not in list), specify",
      "relevant": "selected(${{self}}, 'OTHER')"
    }
  },
